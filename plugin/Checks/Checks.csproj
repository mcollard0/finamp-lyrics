<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><JellyfinLine Condition="'$(JellyfinLine)' == ''">10.11</JellyfinLine>
    <TargetFramework Condition="'$(JellyfinLine)' == '10.11'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinLine)' == '12'">net10.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <JellyfinInstallDir Condition="'$(JellyfinInstallDir)' == '' and '$(JellyfinLine)' == '10.11'">$(MSBuildThisFileDirectory)../artifacts/server-reference/usr/lib/jellyfin</JellyfinInstallDir>
    <JellyfinInstallDir Condition="'$(JellyfinInstallDir)' == '' and '$(JellyfinLine)' == '12'">$(MSBuildThisFileDirectory)../artifacts/server-reference-12</JellyfinInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../FinampLyrics/FinampLyrics.csproj" />
    <Reference Include="MediaBrowser.Controller"><HintPath>$(JellyfinInstallDir)/MediaBrowser.Controller.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>$(JellyfinInstallDir)/MediaBrowser.Common.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>$(JellyfinInstallDir)/MediaBrowser.Model.dll</HintPath></Reference>
    <Reference Include="Jellyfin.Data"><HintPath>$(JellyfinInstallDir)/Jellyfin.Data.dll</HintPath></Reference>
  </ItemGroup>
</Project>
